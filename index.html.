function renderMenuOptions(){

  if(
    !current ||
    current.role !== "Administrador"
  ){

    return;
  }


  const container =
    document.getElementById("menuOptions");


  const custom =
    db.menu.filter(m =>
      !m.system
    );


  if(!custom.length){

    container.innerHTML =
      `<p class="muted">
        No has agregado opciones personalizadas.
      </p>`;

    return;
  }


  container.innerHTML =
    custom.map(m => `

      <div class="menu-item">

        <div class="menu-title">
          ${escapeHTML(m.icon || "📌")}
          ${escapeHTML(m.name)}
        </div>

        <button
          class="btn danger small"
          onclick="deleteMenuOption('${m.id}')">
          🗑️ Eliminar
        </button>

      </div>

    `).join("");

}


function addMenuOption(){

  if(
    !current ||
    current.role !== "Administrador"
  ){

    alert("No tienes permisos.");

    return;
  }


  const nombre =
    document.getElementById("newMenuName")
      .value.trim();

  const icono =
    document.getElementById("newMenuIcon")
      .value.trim();


  if(!nombre){

    alert(
      "Escribe un nombre para la opción."
    );

    return;
  }


  const id =
    "custom_" + Date.now();


  db.menu.push({

    id,

    nombre,

    name:nombre,

    icono:icono || "📌",

    icon:icono || "📌",

    system:false

  });


  persist();

  document.getElementById("newMenuName").value = "";
  document.getElementById("newMenuIcon").value = "";

  renderMenuOptions();

  addCustomMenuButton({
    id,
    name:nombre,
    icon:icono || "📌"
  });


  alert("Opción agregada al menú.");

}


function addCustomMenuButton(item){

  const nav =
    document.getElementById("mainNav");


  if(
    document.querySelector(
      `nav button[data-custom="${item.id}"]`
    )
  ){

    return;

  }


  const button =
    document.createElement("button");

  button.dataset.custom =
    item.id;

  button.innerHTML =
    `${escapeHTML(item.icon || "📌")}
     ${escapeHTML(item.name)}`;

  button.onclick = function(){

    openCustomMenu(item);

  };


  const settings =
    nav.querySelector(
      'button[data-v="settings"]'
    );


  nav.insertBefore(
    button,
    settings
  );

}


function deleteMenuOption(id){

  if(
    !confirm(
      "¿Eliminar esta opción personalizada?"
    )
  ){

    return;

  }


  db.menu =
    db.menu.filter(m =>
      m.id !== id
    );

  persist();

  const btn =
    document.querySelector(
      `nav button[data-custom="${id}"]`
    );

  if(btn){
    btn.remove();
  }

  renderMenuOptions();

}


function openCustomMenu(item){

  document
    .querySelectorAll(".view")
    .forEach(v =>
      v.classList.remove("active")
    );

  const main =
    document.querySelector("main");

  let customView =
    document.getElementById(
      "custom_" + item.id
    );

  if(!customView){

    customView =
      document.createElement("section");

    customView.className =
      "view active";

    customView.id =
      "custom_" + item.id;

    customView.innerHTML = `

      <h2>
        ${escapeHTML(item.icon || "📌")}
        ${escapeHTML(item.name)}
      </h2>

      <div class="card">

        <h3>
          ${escapeHTML(item.name)}
        </h3>

        <p class="muted">
          Esta es una opción personalizada
          del menú de Canopy Control.
        </p>

        <div class="notice">
          Puedes utilizar esta sección para
          organizar información adicional de
          tu operación.
        </div>

      </div>

    `;

    main.appendChild(customView);

  }else{

    customView.classList.add("active");

  }


  document
    .querySelectorAll("nav button")
    .forEach(b =>
      b.classList.remove("active")
    );

}


/* =========================================================
   RECONSTRUIR MENÚ PERSONALIZADO
========================================================= */

function renderCustomMenu(){

  const custom =
    db.menu.filter(m =>
      !m.system
    );


  custom.forEach(m => {

