========================================================= */

function renderReview(){

  const select =
    document.getElementById("reviewEquip");

  const old =
    select.value;

  select.innerHTML =

    `<option value="">
      Selecciona un equipo
    </option>` +

    db.equipment.map(e => `
      <option value="${e.id}">
        ${escapeHTML(e.num)} · ${escapeHTML(e.type)}
      </option>
    `).join("");

  if(
    old &&
    db.equipment.some(e =>
      String(e.id) === String(old)
    )
  ){

    select.value = old;

  }

}


function saveReview(){

  const equipmentId =
    document.getElementById("reviewEquip").value;

  const status =
    document.getElementById("reviewStatus").value;

  const note =
    document.getElementById("reviewNote").value.trim();

  const used =
    document.getElementById("reviewUsed").value;


  if(!equipmentId){

    alert("Selecciona un equipo.");

    return;
  }


  const e =
    db.equipment.find(x =>
      String(x.id) === String(equipmentId)
    );

  if(!e){

    alert("No se encontró el equipo.");

    return;
  }


  e.status = status;

  e.note = note;


  db.reviews.push({

    id:Date.now(),

    date:new Date().toISOString(),

    equipmentId:e.id,

    status,

    used,

    note,

    user:current
      ? current.user
      : ""

  });


  persist();

  document.getElementById("reviewNote").value = "";

  alert("Revisión guardada correctamente.");

  renderAll();

}


