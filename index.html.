function exportCSV(){

  const lines = [

    [
      "Fecha",
      "Equipo",
      "Estado",
      "Uso",
      "Observación",
      "Usuario"
    ]

  ];


  db.reviews.forEach(r => {

    const e =
      db.equipment.find(x =>
        x.id === r.equipmentId
      );

    lines.push([

      formatDate(r.date),

      e ? e.num : "",

      r.status,

      r.used,

      r.note || "",

      r.user || ""

    ]);

  });


  const csv =
    lines.map(row =>
      row.map(value =>
        `"${String(value)
          .replace(/"/g,'""')}"`
      ).join(",")
    ).join("\n");


  const blob =
    new Blob(
      ["\uFEFF" + csv],
      {
        type:"text/csv;charset=utf-8"
      }
    );


  const url =
    URL.createObjectURL(blob);

  const a =
    document.createElement("a");

  a.href = url;

  a.download =
    "canopy-control-reportes.csv";

  document.body.appendChild(a);

  a.click();

  a.remove();

  URL.revokeObjectURL(url);

}


