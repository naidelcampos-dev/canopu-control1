function toggleUserPassword(id){

  const u =
    db.users.find(x => x.id === id);

  const el =
    document.getElementById("pass_" + id);

  if(!u || !el) return;


  if(el.dataset.visible === "yes"){

    el.textContent = "••••••••";

    el.dataset.visible = "no";

  }else{

    el.textContent = u.pass;

    el.dataset.visible = "yes";

  }

}


function openUserForm(){

  document
    .getElementById("userForm")
    .classList.remove("hidden");

  document.getElementById("newName").value = "";
  document.getElementById("newUser").value = "";
  document.getElementById("newPass").value = "";
  document.getElementById("newRole").value = "Editor";

}


function closeUserForm(){

  document
    .getElementById("userForm")
    .classList.add("hidden");

}


function toggleNewPassword(){

  const input =
    document.getElementById("newPass");

  input.type =
    input.type === "password"
      ? "text"
      : "password";

}


function saveUser(){

  if(
    !current ||
    current.role !== "Administrador"
  ){

    alert("No tienes permisos.");

    return;
  }


  const name =
    document.getElementById("newName")
      .value.trim();

  const user =
    document.getElementById("newUser")
      .value.trim();

  const pass =
    document.getElementById("newPass")
      .value;

  const role =
    document.getElementById("newRole")
      .value;


  if(!name || !user || !pass){

    alert(
      "Completa nombre, usuario y contraseña."
    );

    return;
  }


  if(
    db.users.some(u =>
      u.user.toLowerCase() ===
      user.toLowerCase()
    )
  ){

    alert("Ese usuario ya existe.");

    return;
  }


  db.users.push({

    id:Date.now(),

    name,

    user,

    pass,

    role

  });


  persist();

  closeUserForm();

  renderUsers();

  alert("Usuario creado correctamente.");

}


function deleteUser(id){

  if(
    !current ||
    current.role !== "Administrador"
  ){

    return;
  }


  const u =
    db.users.find(x => x.id === id);

  if(!u) return;


  if(u.user === "admin"){

    alert(
      "El usuario administrador principal no se puede eliminar."
    );

    return;
  }


  if(!confirm(
    `¿Eliminar al usuario ${u.name}?`
  )){

    return;

  }


  db.users =
    db.users.filter(x =>
      x.id !== id
    );

  persist();

  renderUsers();

}


