function openEquipmentForm(){

  document
    .getElementById("equipmentForm")
    .classList.remove("hidden");

  document.getElementById("equipmentFormTitle")
    .textContent = "Agregar equipo";

  document.getElementById("equipmentId").value = "";
  document.getElementById("equipmentNum").value = "";
  document.getElementById("equipmentType").value = "";
  document.getElementById("equipmentBrand").value = "";
  document.getElementById("equipmentStatus").value = "Bueno";
  document.getElementById("equipmentNote").value = "";

}


function closeEquipmentForm(){

  document
    .getElementById("equipmentForm")
    .classList.add("hidden");

}


function editEquipment(id){

  const e =
    db.equipment.find(x => x.id === id);

  if(!e) return;

  openEquipmentForm();

  document.getElementById("equipmentFormTitle")
    .textContent = "Editar equipo";

  document.getElementById("equipmentId").value = e.id;
  document.getElementById("equipmentNum").value = e.num;
  document.getElementById("equipmentType").value = e.type;
  document.getElementById("equipmentBrand").value = e.brand;
  document.getElementById("equipmentStatus").value = e.status;
  document.getElementById("equipmentNote").value = e.note || "";

}


function saveEquipment(){

  const id =
    document.getElementById("equipmentId").value;

  const num =
    document.getElementById("equipmentNum").value.trim();

  const type =
    document.getElementById("equipmentType").value.trim();

  const brand =
    document.getElementById("equipmentBrand").value.trim();

  const status =
    document.getElementById("equipmentStatus").value;

  const note =
    document.getElementById("equipmentNote").value.trim();


  if(!num || !type){

    alert("Escribe al menos el código y el tipo.");

    return;
  }


  if(id){

    const e =
      db.equipment.find(x =>
        String(x.id) === String(id)
      );

    if(e){

      e.num = num;
      e.type = type;
      e.brand = brand;
      e.status = status;
      e.note = note;

    }

  }else{

    db.equipment.push({

      id:Date.now(),
      num,
      type,
      brand,
      status,
      note

    });

  }


  persist();

  closeEquipmentForm();

  renderAll();

  showView("equipment");

}


function deleteEquipment(id){

  const e =
    db.equipment.find(x => x.id === id);

  if(!e) return;

  if(!confirm(
    `¿Eliminar el equipo ${e.num}?`
  )){
    return;
  }

  db.equipment =
    db.equipment.filter(x =>
      x.id !== id
    );

  persist();

  renderAll();

}


