/* =========================================================
   UTILIDADES
========================================================= */

function statusClass(status){

  if(status === "Bueno"){
    return "good";
  }

  if(status === "Revisión"){
    return "warning";
  }

  return "bad";

}


function formatDate(date){

  try{

    return new Date(date)
      .toLocaleString(
        "es-ES",
        {
          dateStyle:"short",
          timeStyle:"short"
        }
      );

  }catch(e){

    return date;

  }

}


function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


